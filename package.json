{
  "name": "@leemour/cli-messaging",
  "version": "0.114.0",
  "description": "The messenger-neutral half of a messaging CLI: domain model, message locators, rendering, name resolution, the SQLite seam, the command skeleton and shared read commands, the send guard, run records and the message store",
  "license": "MIT",
  "author": "Viacheslav Ptsarev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leemour/cli-messaging.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "packageManager": "pnpm@11.20.0",
  "files": [
    "dist",
    "parity.json",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite-runtime": {
      "types": "./dist/sqlite-runtime.d.ts",
      "default": "./dist/sqlite-runtime.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./sends": {
      "types": "./dist/sends/index.d.ts",
      "default": "./dist/sends/index.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "default": "./dist/services/index.js"
    },
    "./background": {
      "types": "./dist/background/index.d.ts",
      "default": "./dist/background/index.js"
    },
    "./parity": {
      "types": "./dist/parity/index.d.ts",
      "default": "./dist/parity/index.js"
    },
    "./testing": {
      "types": "./dist/kit/index.d.ts",
      "default": "./dist/kit/index.js"
    },
    "./parity.json": "./parity.json"
  },
  "scripts": {
    "build": "tsc --build && node scripts/bundle-drizzle.ts",
    "check:dist": "node scripts/check-dist.ts",
    "typecheck": "tsc --build --force --emitDeclarationOnly && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:bundle": "node scripts/bundle-migrations.ts",
    "docs:check": "node --experimental-strip-types scripts/docs-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:slow": "vitest run --reporter=json --outputFile=coverage/tests.json >/dev/null; cli-dev slow-tests",
    "smoke:bun": "bun run scripts/smoke.ts",
    "prepare": "lefthook install || true",
    "secrets:scan": "gitleaks git --no-banner --redact .",
    "prepublishOnly": "pnpm build",
    "parity:seed": "tsc --build && node --experimental-strip-types scripts/parity-seed.ts",
    "parity:render": "node --experimental-strip-types scripts/parity-render.ts",
    "parity:audit": "tsc --build && node --experimental-strip-types scripts/parity-audit.ts"
  },
  "dependencies": {
    "@bomb.sh/tab": "0.0.22",
    "@huggingface/tokenizers": "0.2.0",
    "@leemour/cli-messaging-onnx": "1.0.0",
    "@leemour/cli-messaging-sqlite": "1.0.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@valibot/to-json-schema": "1.8.0",
    "ogg-opus-decoder": "1.7.5",
    "qrcode-generator": "2.0.4",
    "sherpa-onnx": "1.13.8",
    "string-width": "8.3.0",
    "valibot": "1.5.0",
    "wrap-ansi": "10.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@leemour/cli-core": "0.16.0",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/node": "^22.20.4",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "^5.0.2",
    "cli-messaging-0.13": "npm:@leemour/cli-messaging@0.13.0",
    "cli-messaging-0.27": "npm:@leemour/cli-messaging@0.27.0",
    "cli-messaging-0.49": "npm:@leemour/cli-messaging@0.49.0",
    "commander": "15.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "esbuild": "0.25.12",
    "jsqr": "1.4.0",
    "lefthook": "^2.1.8",
    "pngjs": "7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@leemour/cli-core": ">=0.16.0 <0.17.0",
    "commander": ">=15"
  },
  "bin": {
    "cli-messaging-parity": "dist/parity/bin.js"
  }
}
