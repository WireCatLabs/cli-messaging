#!/usr/bin/env sh
# Publishes the version in package.json and tags it. Run on a clean `main`.
#
#   bin/release           # publishes from GitHub Actions (.github/workflows/release.yml)
#   bin/release --local   # publishes from this machine: NPM_TOKEN if exported, else the keyring
#
# The npm token is never printed and never written to a file — not on success, not in an error.
set -eu

cd "$(dirname "$0")/.."
package=@leemour/cli-messaging

mode=ci
case "${1:-}" in
  "") ;;
  --local) mode=local ;;
  *) echo "usage: bin/release [--local]" >&2; exit 2 ;;
esac

git fetch -q origin
[ "$(git branch --show-current)" = "main" ] || { echo "not on main" >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "uncommitted changes" >&2; exit 1; }
before=$(git rev-parse HEAD)
git merge -q --ff-only origin/main
# The shell keeps running the file it read before the merge; max-cli published with a stale copy.
[ "$(git rev-parse HEAD)" = "$before" ] || exec "$0" "$@"
# The workflow publishes origin/main, so a local commit not pushed yet would silently not ship.
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || { echo "main is ahead of origin/main — push first" >&2; exit 1; }

version=$(node -p 'require("./package.json").version')
# `npm view` rather than the registry document, which a CDN serves stale for minutes.
published() {
  npm view "$package@$version" version --prefer-online >/dev/null 2>&1
}
if published; then
  echo "$version is already on npm — raise the version first" >&2
  exit 1
fi

if [ "$mode" = ci ]; then
  last_run() {
    gh run list --workflow release.yml --branch main --event workflow_dispatch --limit 1 \
      --json databaseId --jq '.[0].databaseId // ""'
  }
  previous=$(last_run)
  echo "== starting the release workflow for $version =="
  gh workflow run release.yml --ref main
  run=""
  for _ in $(seq 30); do
    run=$(last_run)
    [ -n "$run" ] && [ "$run" != "$previous" ] && break
    run=""
    sleep 2
  done
  [ -n "$run" ] || { echo "the release workflow did not start within a minute — see gh run list --workflow release.yml" >&2; exit 1; }
  gh run watch "$run" --exit-status
  git fetch -q --tags origin
  echo "published $package@$version"
  exit 0
fi

echo "== checks for $version =="
pnpm install --frozen-lockfile
pnpm lint && pnpm typecheck && pnpm test
pnpm build && pnpm smoke:bun

if [ -z "${NPM_TOKEN:-}" ]; then
  NPM_TOKEN=$(secret-tool lookup service npm account leemour 2>/dev/null) || {
    echo "no npm token: export NPM_TOKEN, or store one with: secret-tool store --label=npm service npm account leemour" >&2
    exit 1
  }
fi
[ -n "$NPM_TOKEN" ] || { echo "the npm token is empty" >&2; exit 1; }
export NPM_TOKEN

# A config of our own that names the variable, not the value: the token stays in the environment,
# and the user's ~/.npmrc is neither read nor changed.
config=$(mktemp)
trap 'rm -f "$config"' EXIT
printf '//registry.npmjs.org/:_authToken=${NPM_TOKEN}\n' > "$config"

echo "== publishing $version =="
npm publish --access public --userconfig "$config"

echo "== waiting for npm to show $version (up to three minutes) =="
seen=""
for _ in $(seq 36); do
  if published; then seen=1; break; fi
  sleep 5
done
[ -n "$seen" ] || { echo "npm does not show $version after three minutes — not tagging; tag v$version by hand once it does" >&2; exit 1; }

echo "== tag v$version =="
git tag -a "v$version" -m "$version"
git push -q origin "v$version"
echo "published $package@$version"
